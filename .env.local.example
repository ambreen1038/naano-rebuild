# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings -> API). .env.local is gitignored — never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: server-only, bypasses RLS. Used solely by the /r/[slug]
# click-tracking route. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

