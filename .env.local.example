# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings -> API). .env.local is gitignored — never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: server-only, bypasses RLS. Used solely by the /r/[slug]
# click-tracking route. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Get a free key at https://aistudio.google.com/apikey. Server-only, used to
# draft a brand's Product Summary from their website (src/lib/website-scan.ts)
# — never sent to the client. Optional: the feature degrades gracefully
# (real website data, no AI text) if this is left unset.
GOOGLE_GENERATIVE_AI_API_KEY=

